# ─────────────────────────── Database ───────────────────────────
# Recommended for production: Neon (neon.tech) or Supabase — both have a generous free tier
DATABASE_URL="postgresql://scanner:scanner_dev_password@localhost:5432/security_scanner"

# ─────────────────────────── Queue (Redis) ───────────────────────────
# Recommended for production: Upstash (upstash.com) — serverless Redis, integrates easily with Vercel
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ─────────────────────────── Auth (NextAuth + GitHub OAuth) ───────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: https://YOUR_DOMAIN/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXTAUTH_SECRET="" # generate with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────── Token encryption ───────────────────────────
ENCRYPTION_SECRET="" # generate with: openssl rand -base64 32 — NEVER rotate once data has been stored

# ─────────────────────────── Billing (Stripe) ───────────────────────────
# Only needed once an admin turns billing on from /admin/settings — the app
# runs fine without these in soft-launch mode. Create Price objects in the
# Stripe dashboard for each paid plan (Starter/Pro/Scale) and paste their
# IDs below; the dollar amounts shown on /pricing come from the PlanConfig
# rows in the database (editable at /admin/plans), not from these prices —
# keep both in sync manually when you change one.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="" # from `stripe listen` locally, or the Stripe dashboard in production
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""

# ─────────────────────────── Claude API (fix prompt generation) ───────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_PROMPT_GEN_MODEL="claude-sonnet-4-6"

# ─────────────────────────── MobSF (mobile SAST) ───────────────────────────
MOBSF_URL="http://localhost:8000"
MOBSF_API_KEY="dev-local-key-change-in-prod"

# ─────────────────────────── Storage (zip/7z uploads) ───────────────────────────
# Recommended for production: Cloudflare R2 (S3-compatible, no egress fees) or AWS S3
STORAGE_PROVIDER="s3" # "s3" | "r2"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT="" # required for R2, leave empty for standard S3
STORAGE_REGION="auto"

# ─────────────────────────── Worker ───────────────────────────
WORKER_CONCURRENCY="2" # how many concurrent scans per worker instance
